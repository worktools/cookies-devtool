{
  "manifest_version": 3,
  "name": "Cookie Editor",
  "version": "0.1.0",
  "description": "View, filter and edit cookies of the inspected page in a DevTools panel.",
  "minimum_chrome_version": "119",
  "devtools_page": "devtools.html",
  "permissions": ["cookies"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
